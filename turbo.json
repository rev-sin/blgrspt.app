{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "//#build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".astro/**"]
    },
    "//#check": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "//#lint": {
      "inputs": ["$TURBO_DEFAULT$", ".oxlintrc.json"]
    },
    "//#fmt": {
      "inputs": ["$TURBO_DEFAULT$", ".oxfmtrc.json", ".prettierrc"]
    }
  }
}
