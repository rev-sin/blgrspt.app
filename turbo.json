{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "//#build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".astro/**"]
    },
    "//#check": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "//#lint": {
      "inputs": ["$TURBO_DEFAULT$", ".oxlintrc.json"]
    },
    "//#fmt": {
      "inputs": ["$TURBO_DEFAULT$", ".oxfmtrc.json", ".prettierrc"]
    },
    "//#test": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "@blgrspt/docs#build": {
      "outputs": ["build/**", ".docusaurus/**"]
    },
    "@blgrspt/docs#typecheck": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "@blgrspt/docs#start": {
      "cache": false,
      "persistent": true
    }
  }
}
