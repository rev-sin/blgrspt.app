    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@astrojs/svelte": "^9.0.1",
    "@astrojs/vercel": "^11.0.7",
    "@better-auth/drizzle-adapter": "^1.7.1",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/oxanium": "^5.3.0",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.33.0",
    "@nanostores/svelte": "^0.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "@t3-oss/env-core": "^0.11.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.4",
    "better-auth": "^1.7.1",
    "bits-ui": "^2.16.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "nanostores": "^0.11.3",
    "sharp": "^0.33.5",
    "svelte": "^5.56.10",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@types/node": "^26.2.0",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "knip": "^5.45.0",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.5.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^3.3.3",
    "shadcn-svelte": "^1.5.0",
    "svelte-check": "^4.1.4",
    "tsx": "^4.19.3",
    "tw-animate-css": "^1.4.0"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{svelte,astro}": [
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": "24.19.0"
  }
