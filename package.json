{
  "name": "blgrspt.app",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "prepare": "husky",
    "check": "astro check && svelte-check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt && prettier --write \"**/*.{svelte,astro}\"",
    "fmt:check": "oxfmt --check && prettier --check \"**/*.{svelte,astro}\"",
    "commit": "git-cz",
    "deps:check": "taze",
    "deps:update": "taze -u",
    "knip": "knip",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "turbo:build": "turbo run //#build",
    "turbo:check": "turbo run //#check",
    "turbo:lint": "turbo run //#lint"
  },
  "dependencies": {
    "@astrojs/svelte": "^9.0.1",
    "@astrojs/vercel": "^11.0.7",
    "@better-auth/drizzle-adapter": "^1.7.1",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/oxanium": "^5.3.0",
    "@internationalized/date": "^3.12.3",
    "@lucide/svelte": "^1.33.0",
    "@neondatabase/serverless": "^1.1.0",
    "@t3-oss/env-core": "^0.11.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.4",
    "better-auth": "^1.7.1",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "nanostores": "^0.11.4",
    "sharp": "^0.33.5",
    "svelte": "^5.56.10",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/node": "^26.2.0",
    "commitizen": "^4.3.2",
    "cz-git": "^1.14.0",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-zod": "^0.7.1",
    "husky": "^9.1.7",
    "knip": "^5.88.1",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^3.5.2",
    "shadcn-svelte": "^1.5.0",
    "svelte-check": "^4.7.6",
    "taze": "^18.7.1",
    "tsx": "^4.23.12",
    "turbo": "^2.10.11",
    "tw-animate-css": "^1.4.0"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{svelte,astro}": [
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "oxfmt"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "engines": {
    "node": "24.19.0"
  },
  "packageManager": "bun@1.3.14"
}
