---
import { eq } from "drizzle-orm";

import CopyLinkButton from "$lib/components/blog/CopyLinkButton.svelte";
import MermaidInitializer from "$lib/components/blog/MermaidInitializer.svelte";
import { db } from "$lib/db";
import { post as postTable, user as userTable } from "$lib/db/schema";
import { isAdminUser } from "$lib/auth/rbac";
import { canManagePost, canViewPost } from "$lib/posts/access";
import { postWithAuthorColumns } from "$lib/posts/with-author";
import { renderMarkdown } from "$lib/markdown";

import "../../styles/global.css";

export const prerender = false;

const { slug } = Astro.params;

if (!slug) {
  return new Response("Post not found", { status: 404 });
}

const [post] = await db
  .select(postWithAuthorColumns)
  .from(postTable)
  .innerJoin(userTable, eq(postTable.authorId, userTable.id))
  .where(eq(postTable.slug, slug))
  .limit(1);

const viewerIsAdmin = isAdminUser(Astro.locals.user);

if (!post || !canViewPost(post, Astro.locals.user?.id, viewerIsAdmin)) {
  return new Response("Post not found", { status: 404 });
}

const canEdit = canManagePost(post, Astro.locals.user?.id, viewerIsAdmin);

const renderedContent = renderMarkdown(post.content);

const visibilityLabel =
  post.status === "draft"
    ? "Draft"
    : post.visibility === "private"
      ? "Private"
      : post.visibility === "unlisted"
        ? "Unlisted"
        : null;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{post.title} · blgrspt</title>

    {post.excerpt && <meta name="description" content={post.excerpt} />}
  </head>

  <body class="bg-[#15100e] text-[#f4ebe3]">
    <main class="min-h-screen">
      <article class="mx-auto w-full max-w-4xl px-6 py-16 md:py-24">
        <!-- Navigation -->
        <div class="mb-12 flex items-center justify-between gap-4">
          <a
            href="/feed"
            class="font-[Oxanium] text-xs
                   uppercase tracking-[0.2em]
                   text-[#f4ebe3]/40
                   transition
                   hover:text-[#f4ebe3]"
          >
            ← Back
          </a>

          <div class="flex items-center gap-2">
            <CopyLinkButton client:load slug={post.slug} />

            {
              canEdit && (
                <a
                  href={`/blog/edit/${post.slug}`}
                  class="rounded-xl
                         border border-[#ffe1ca]/10
                         bg-[#1b1411]
                         px-4 py-2
                         font-[Oxanium]
                         text-xs
                         uppercase
                         tracking-[0.15em]
                         text-[#f4ebe3]/60
                         transition
                         hover:border-[#ffe1ca]/20
                         hover:bg-[#221915]
                         hover:text-[#f4ebe3]"
                >
                  Edit
                </a>
              )
            }
          </div>
        </div>

        <!-- Header -->
        <header class="mb-12">
          {
            post.tags?.length > 0 && (
              <div class="mb-6 flex flex-wrap gap-2">
                {post.tags.map((tag: string) => (
                  <span
                    class="rounded-full
                           border border-[#ffe1ca]/10
                           bg-[#1b1411]
                           px-3 py-1
                           font-[Oxanium]
                           text-[10px]
                           uppercase
                           tracking-[0.15em]
                           text-[#f4ebe3]/45"
                  >
                    #{tag}
                  </span>
                ))}
              </div>
            )
          }

          <h1
            class="font-[Oxanium]
                   text-4xl
                   font-medium
                   tracking-[-1.5px]
                   text-[#f7eee7]
                   md:text-6xl"
          >
            {post.title}
          </h1>

          {
            post.excerpt && (
              <p
                class="mt-6
                       max-w-2xl
                       text-lg
                       leading-8
                       text-[#f4ebe3]/45"
              >
                {post.excerpt}
              </p>
            )
          }

          <div
            class="mt-8
                   flex flex-wrap
                   items-center
                   gap-3
                   font-[Oxanium]
                   text-[10px]
                   uppercase
                   tracking-[0.18em]
                   text-[#f4ebe3]/25"
          >
            {
              visibilityLabel && (
                <span
                  class="rounded-full
                         border border-[#ffe1ca]/15
                         px-2 py-1
                         text-[#d7a77e]/80"
                >
                  {visibilityLabel}
                </span>
              )
            }

            {
              post.publishedAt && (
                <span>{new Date(post.publishedAt).toLocaleDateString()}</span>
              )
            }

            <span>·</span>

            <a
              href={`/u/${post.authorId}`}
              class="transition hover:text-[#f4ebe3]"
            >
              {post.authorName}
            </a>

            <span>·</span>

            <span>{post.contentType}</span>
          </div>
        </header>

        <!-- Divider -->
        <div class="h-px w-full bg-[#ffe1ca]/10"></div>

        <!-- Markdown Content -->
        <article class="markdown-content py-12" set:html={renderedContent} />

        <!-- Mermaid -->
        <MermaidInitializer client:load />
      </article>
    </main>
  </body>
</html>
