---
import { eq } from "drizzle-orm";

import EditPostPage from "$lib/components/blog/editor/EditPostPage.svelte";
import { isAdminUser } from "$lib/auth/rbac";
import { db } from "$lib/db";
import { post as postTable } from "$lib/db/schema";
import { canManagePost, canViewPost } from "$lib/posts/access";
import "../../../styles/global.css";

export const prerender = false;

const { slug } = Astro.params;

if (!slug) {
  return new Response("Post not found", { status: 404 });
}

if (!Astro.locals.user) {
  return Astro.redirect("/feed");
}

const isAdmin = isAdminUser(Astro.locals.user);

const [post] = await db
  .select()
  .from(postTable)
  .where(eq(postTable.slug, slug))
  .limit(1);

if (!post || !canViewPost(post, Astro.locals.user.id, isAdmin)) {
  return Astro.redirect("/dashboard");
}

if (!canManagePost(post, Astro.locals.user.id, isAdmin)) {
  return Astro.redirect(`/blog/${post.slug}`);
}

const editorPost = {
  id: post.id,
  title: post.title,
  slug: post.slug,
  excerpt: post.excerpt,
  content: post.content,
  coverImage: post.coverImage,
  tags: post.tags,
  status: post.status as "draft" | "published",
  visibility: post.visibility as "private" | "unlisted" | "public",
  contentType: post.contentType,
};

const backHref =
  isAdmin && post.authorId !== Astro.locals.user.id ? "/admin" : "/dashboard";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Edit {post.title}</title>
  </head>

  <body class="bg-[#15100e]">
    <EditPostPage client:load post={editorPost} backHref={backHref} />
  </body>
</html>
