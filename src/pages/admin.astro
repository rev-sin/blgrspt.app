---
import { isAdminUser } from "$lib/auth/rbac";
import AdminPage from "$lib/components/blog/AdminPage.svelte";
import "../styles/global.css";

export const prerender = false;

if (!Astro.locals.user) {
  return Astro.redirect("/");
}

if (!isAdminUser(Astro.locals.user)) {
  return Astro.redirect(`/u/${Astro.locals.user.id}`);
}

const user = Astro.locals.user;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Admin</title>
  </head>

  <body>
    <AdminPage client:load user={user} />
  </body>
</html>
